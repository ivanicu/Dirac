{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirac.local/contracts/domain/motif/resource-lease.schema.json",
  "title": "Motif Atomic Resource Lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lease_id", "owner_ref", "campaign_ref", "backend", "request", "estimated_cost", "actual_usage", "fencing_token", "state", "lease_owner", "expires_at", "heartbeat_at", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "lease_id": {"type": "string", "format": "uuid"},
    "owner_ref": {"$ref": "#/$defs/ref"},
    "campaign_ref": {"$ref": "#/$defs/ref"},
    "backend": {"enum": ["inline", "local_cpu", "local_gpu", "slurm", "kubernetes", "hpc_relay"]},
    "request": {"$ref": "#/$defs/resources"},
    "estimated_cost": {"type": "object"},
    "actual_usage": {"type": "object"},
    "fencing_token": {"type": "integer", "minimum": 1},
    "state": {"enum": ["active", "released", "expired", "revoked"]},
    "lease_owner": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "released_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"type": "string"}, "id": {"type": "string", "minLength": 1}}},
    "resources": {"type": "object", "additionalProperties": false, "properties": {"cpu_cores": {"type": "number", "minimum": 0}, "ram_bytes": {"type": "number", "minimum": 0}, "gpus": {"type": "number", "minimum": 0}, "gpu_vram_bytes": {"type": "number", "minimum": 0}, "scratch_bytes": {"type": "number", "minimum": 0}, "persistent_growth_bytes": {"type": "number", "minimum": 0}, "process_slots": {"type": "number", "minimum": 0}, "scf_slots": {"type": "number", "minimum": 0}, "campaign_credits": {"type": "number", "minimum": 0}}}
  }
}
