{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirac.local/contracts/domain/motif/measurement-v2.schema.json",
  "title": "Dirac Protocol-Resolved Measurement v2",
  "description": "A measurement is a contextual observation tied to sample, assay, protocol, endpoint, qualifier, unit, QC and provenance. Missing or censored values are not silently converted to point measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "measurement_id", "sample", "assay", "protocol",
    "endpoint", "qualifier", "quantity", "qc", "source", "measured_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "measurement_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "sample": {"$ref": "#/$defs/sample_ref"},
    "batch": {"oneOf": [{"$ref": "#/$defs/batch_ref"}, {"type": "null"}]},
    "compound": {"oneOf": [{"$ref": "#/$defs/compound_ref"}, {"type": "null"}]},
    "assay": {"$ref": "#/$defs/assay_ref"},
    "protocol": {"$ref": "#/$defs/protocol_ref"},
    "endpoint": {"$ref": "#/$defs/endpoint_ref"},
    "qualifier": {
      "enum": [
        "equal", "less_than", "less_or_equal", "greater_than",
        "greater_or_equal", "interval", "not_tested", "missing"
      ]
    },
    "quantity": {"$ref": "#/$defs/quantity"},
    "uncertainty": {
      "oneOf": [{"$ref": "#/$defs/uncertainty"}, {"type": "null"}]
    },
    "limits": {"$ref": "#/$defs/limits"},
    "replicate": {"$ref": "#/$defs/replicate"},
    "qc": {"$ref": "#/$defs/qc"},
    "missing_reason": {
      "type": ["string", "null"],
      "enum": [
        null, "not_requested", "not_tested", "insufficient_sample",
        "sample_qc_failed", "assay_failed", "instrument_failed",
        "protocol_deviation", "below_detection", "above_detection",
        "data_unavailable", "other"
      ]
    },
    "missing_reason_detail": {"type": ["string", "null"], "maxLength": 4096},
    "value_status": {"enum": ["raw", "normalized", "derived"]},
    "derivation": {
      "oneOf": [{"$ref": "#/$defs/derivation"}, {"type": "null"}]
    },
    "source": {"$ref": "#/$defs/source"},
    "measured_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "recorded_by": {"$ref": "#/$defs/actor"}
  },
  "allOf": [
    {
      "if": {"properties": {"qualifier": {"const": "equal"}}, "required": ["qualifier"]},
      "then": {
        "properties": {
          "quantity": {
            "required": ["value", "unit"],
            "properties": {
              "lower": false,
              "upper": false
            }
          },
          "missing_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"qualifier": {"enum": ["less_than", "less_or_equal"]}}, "required": ["qualifier"]},
      "then": {
        "properties": {
          "quantity": {
            "required": ["upper", "unit"],
            "properties": {"value": false, "lower": false}
          },
          "missing_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"qualifier": {"enum": ["greater_than", "greater_or_equal"]}}, "required": ["qualifier"]},
      "then": {
        "properties": {
          "quantity": {
            "required": ["lower", "unit"],
            "properties": {"value": false, "upper": false}
          },
          "missing_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"qualifier": {"const": "interval"}}, "required": ["qualifier"]},
      "then": {
        "properties": {
          "quantity": {
            "required": ["lower", "upper", "unit"],
            "properties": {"value": false}
          },
          "missing_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"qualifier": {"enum": ["not_tested", "missing"]}}, "required": ["qualifier"]},
      "then": {
        "properties": {
          "quantity": {
            "required": ["unit"],
            "properties": {"value": false, "lower": false, "upper": false}
          },
          "missing_reason": {"type": "string"}
        },
        "required": ["missing_reason"]
      }
    },
    {
      "if": {"properties": {"value_status": {"enum": ["normalized", "derived"]}}, "required": ["value_status"]},
      "then": {"required": ["derivation"]}
    }
  ],
  "$defs": {
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string"},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "sample_ref": {
      "allOf": [
        {"$ref": "#/$defs/object_ref"},
        {"properties": {"kind": {"const": "sample"}}}
      ]
    },
    "batch_ref": {
      "allOf": [
        {"$ref": "#/$defs/object_ref"},
        {"properties": {"kind": {"const": "batch"}}}
      ]
    },
    "compound_ref": {
      "allOf": [
        {"$ref": "#/$defs/object_ref"},
        {"properties": {"kind": {"const": "compound"}}}
      ]
    },
    "assay_ref": {
      "allOf": [
        {"$ref": "#/$defs/object_ref"},
        {"properties": {"kind": {"const": "assay"}}}
      ]
    },
    "protocol_ref": {
      "allOf": [
        {"$ref": "#/$defs/object_ref"},
        {"properties": {"kind": {"const": "protocol"}}}
      ]
    },
    "endpoint_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "value": {"type": "number"},
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "dimension": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["standard_deviation", "standard_error", "confidence_interval", "credible_interval", "unknown"]},
        "value": {"type": ["number", "null"], "minimum": 0},
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]},
        "level": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "n": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lloq": {"type": ["number", "null"]},
        "uloq": {"type": ["number", "null"]},
        "lod": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "replicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "biological_index": {"type": ["integer", "null"], "minimum": 1},
        "technical_index": {"type": ["integer", "null"], "minimum": 1},
        "plate_id": {"type": ["string", "null"], "maxLength": 256},
        "well": {"type": ["string", "null"], "maxLength": 32},
        "aggregation_group": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"enum": ["pass", "warn", "fail", "not_assessed"]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}
        },
        "reviewer": {"oneOf": [{"$ref": "#/$defs/actor"}, {"type": "null"}]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "source_measurement_ids"],
      "properties": {
        "method": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "parameters": {"type": "object"},
        "source_measurement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "artifact_id": {"type": ["string", "null"], "format": "uuid"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "record_locator"],
      "properties": {
        "artifact_id": {"type": "string", "format": "uuid"},
        "record_locator": {"type": "string", "minLength": 1, "maxLength": 2048},
        "instrument_run_id": {"type": ["string", "null"], "maxLength": 256},
        "import_release": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "agent", "service"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
