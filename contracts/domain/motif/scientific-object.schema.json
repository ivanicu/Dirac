{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirac.local/contracts/domain/motif/scientific-object.schema.json",
  "title": "Motif Scientific Object Graph Node",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "object_id", "object_kind", "semantic_digest", "payload", "dependency_refs", "state", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "object_id": {"type": "string", "format": "uuid"},
    "object_kind": {"enum": ["submitted_compound_record", "chemical_entity", "chemical_state_ensemble", "chemical_microstate", "conformer_ensemble", "conformer_hypothesis", "protein_structure_source", "prepared_receptor_state", "binding_site_hypothesis", "pose_hypothesis", "pose_ensemble", "complex_hypothesis", "parameterized_system", "simulation_run", "free_energy_transformation", "measurement_observation", "prediction_evidence"]},
    "semantic_digest": {"type": "string", "format": "sha256-digest"},
    "payload": {"type": "object"},
    "dependency_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "supersedes_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "state": {"$ref": "#/$defs/state"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"object_kind": {"const": "chemical_state_ensemble"}}, "required": ["object_kind"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/chemical_state_ensemble"}}}},
    {"if": {"properties": {"object_kind": {"const": "chemical_microstate"}}, "required": ["object_kind"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/microstate"}}}},
    {"if": {"properties": {"object_kind": {"const": "prepared_receptor_state"}}, "required": ["object_kind"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/receptor"}}}},
    {"if": {"properties": {"object_kind": {"const": "pose_hypothesis"}}, "required": ["object_kind"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/pose"}}}},
    {"if": {"properties": {"object_kind": {"const": "parameterized_system"}}, "required": ["object_kind"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/parameterized"}}}},
    {"if": {"properties": {"object_kind": {"const": "free_energy_transformation"}}, "required": ["object_kind"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/transformation"}}}}
  ],
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["execution", "applicability", "scientific", "disposition", "claim_eligibility", "reason_codes"], "properties": {"execution": {"enum": ["created", "queued", "admitted", "running", "succeeded", "failed", "cancelled", "lost"]}, "applicability": {"enum": ["unknown", "applicable", "not_applicable", "unsupported", "outside_validated_domain"]}, "scientific": {"enum": ["not_assessed", "accepted", "provisional", "rejected"]}, "disposition": {"enum": ["pending", "selected", "reserve", "deferred", "rejected", "refused"]}, "claim_eligibility": {"enum": ["eligible", "ineligible_technical_smoke", "ineligible_unvalidated_method", "ineligible_outside_validated_domain", "ineligible_provisional_quality", "ineligible_stale", "ineligible_conflict", "ineligible_missing_dependency"]}, "reason_codes": {"type": "array", "items": {"type": "string"}}}},
    "chemical_state_ensemble": {"type": "object", "additionalProperties": false, "required": ["chemical_entity_ref", "condition", "enumeration_engine", "coupling_policy", "microstates", "retained_population_mass", "discarded_population_mass", "truncation", "confidence", "parent_aggregation_policy"], "properties": {"chemical_entity_ref": {"$ref": "#/$defs/ref"}, "condition": {"type": "object"}, "enumeration_engine": {"type": "object"}, "coupling_policy": {"const": "joint_protonation_tautomer_stereo_no_cartesian_product"}, "microstates": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "retained_population_mass": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "discarded_population_mass": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}, "truncation": {"type": "object"}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}, "parent_aggregation_policy": {"enum": ["population_weighted", "worst_case", "policy_defined_distribution"]}}},
    "microstate": {"type": "object", "additionalProperties": false, "required": ["chemical_entity_ref", "canonical_isomeric_smiles", "formal_charge", "protonation_key", "tautomer_key", "stereo_key", "population", "population_uncertainty"], "properties": {"chemical_entity_ref": {"$ref": "#/$defs/ref"}, "canonical_isomeric_smiles": {"type": "string", "minLength": 1}, "formal_charge": {"type": "integer"}, "protonation_key": {"type": "string"}, "tautomer_key": {"type": "string"}, "stereo_key": {"type": "string"}, "population": {"type": "number", "minimum": 0, "maximum": 1}, "population_uncertainty": {"type": ["number", "null"], "minimum": 0}}},
    "receptor": {"type": "object", "additionalProperties": false, "required": ["source_ref", "preparation_release_ref", "construct", "protonation_condition_ref", "retained_waters", "cofactors", "metals", "missing_residue_policy", "artifact_ref"], "properties": {"source_ref": {"$ref": "#/$defs/ref"}, "preparation_release_ref": {"$ref": "#/$defs/ref"}, "construct": {"type": "object"}, "protonation_condition_ref": {"$ref": "#/$defs/ref"}, "retained_waters": {"type": "array", "items": {"type": "string"}}, "cofactors": {"type": "array", "items": {"type": "string"}}, "metals": {"type": "array", "items": {"type": "string"}}, "missing_residue_policy": {"type": "string"}, "artifact_ref": {"$ref": "#/$defs/ref"}}},
    "pose": {"type": "object", "additionalProperties": false, "required": ["microstate_ref", "receptor_state_ref", "binding_site_ref", "conformer_ref", "pose_protocol_release_ref", "seed", "coordinate_artifact_ref", "score_terms", "cluster_ref"], "properties": {"microstate_ref": {"$ref": "#/$defs/ref"}, "receptor_state_ref": {"$ref": "#/$defs/ref"}, "binding_site_ref": {"$ref": "#/$defs/ref"}, "conformer_ref": {"$ref": "#/$defs/ref"}, "pose_protocol_release_ref": {"$ref": "#/$defs/ref"}, "seed": {"type": "integer", "minimum": 0}, "coordinate_artifact_ref": {"$ref": "#/$defs/ref"}, "score_terms": {"type": "object"}, "cluster_ref": {"$ref": "#/$defs/ref"}}},
    "parameterized": {"type": "object", "additionalProperties": false, "required": ["complex_ref", "parameterization_release_ref", "force_fields", "ligand_charge_artifact_ref", "solvation", "ions", "constraints", "system_artifact_ref", "support_class"], "properties": {"complex_ref": {"$ref": "#/$defs/ref"}, "parameterization_release_ref": {"$ref": "#/$defs/ref"}, "force_fields": {"type": "object"}, "ligand_charge_artifact_ref": {"$ref": "#/$defs/ref"}, "solvation": {"type": "object"}, "ions": {"type": "object"}, "constraints": {"type": "object"}, "system_artifact_ref": {"$ref": "#/$defs/ref"}, "support_class": {"type": "string"}}},
    "transformation": {"type": "object", "additionalProperties": false, "required": ["ligand_a_ref", "ligand_b_ref", "mapping_artifact_ref", "charge_invariant_ref", "complex_leg_ref", "solvent_leg_ref", "repeat_index", "sign_convention_ref", "openfe_native_object_refs"], "properties": {"ligand_a_ref": {"$ref": "#/$defs/ref"}, "ligand_b_ref": {"$ref": "#/$defs/ref"}, "mapping_artifact_ref": {"$ref": "#/$defs/ref"}, "charge_invariant_ref": {"$ref": "#/$defs/ref"}, "complex_leg_ref": {"$ref": "#/$defs/ref"}, "solvent_leg_ref": {"$ref": "#/$defs/ref"}, "repeat_index": {"type": "integer", "minimum": 1}, "sign_convention_ref": {"$ref": "#/$defs/ref"}, "openfe_native_object_refs": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}}}
  }
}
