{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirac.local/contracts/domain/motif/motif-cycle.schema.json",
  "title": "Dirac Motif Cycle / RunPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cycle_id", "mission_id", "run_id", "objective_spec_id",
    "program_snapshot_id", "root_seed", "steps", "edges", "policy_releases",
    "resource_envelope", "approval_gates", "digest", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "cycle_id": {"type": "string", "format": "uuid"},
    "mission_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "objective_spec_id": {"type": "string", "format": "uuid"},
    "program_snapshot_id": {"type": "string", "format": "uuid"},
    "root_seed": {"type": "integer", "minimum": 0},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "policy_releases": {"type": "object", "additionalProperties": {"type": "string", "format": "uuid"}},
    "resource_envelope": {"type": "object"},
    "approval_gates": {"type": "array", "items": {"type": "string", "maxLength": 128}, "uniqueItems": true},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "step_key", "kind", "method_id", "required", "job_policy", "input_bindings", "resource_profile"],
      "properties": {
        "step_id": {"type": "string", "format": "uuid"},
        "step_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
        "kind": {"enum": ["compute", "approval", "barrier", "projection", "cleanup"]},
        "method_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$"},
        "required": {"type": "boolean"},
        "job_policy": {"enum": ["none", "optional", "required"]},
        "input_bindings": {"type": "object"},
        "resource_profile": {"type": "string", "minLength": 1},
        "fidelity_level": {"type": ["string", "null"], "enum": [null, "F0", "F1", "F2", "F3", "F4", "F5"]}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["source_step_id", "target_step_id", "kind"],
      "properties": {
        "source_step_id": {"type": "string", "format": "uuid"},
        "target_step_id": {"type": "string", "format": "uuid"},
        "kind": {"enum": ["on_success", "on_failure", "always", "if_metric", "if_artifact_present", "if_approval", "fan_out", "fan_in"]},
        "condition": {"type": ["object", "null"]}
      }
    }
  }
}
