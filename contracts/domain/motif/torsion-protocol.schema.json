{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirac.local/contracts/domain/motif/torsion-protocol.schema.json",
  "title": "Motif Torsion Scan Protocol",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "protocol_release_id", "geometry_source_ref", "level", "dihedrals", "increment_degrees", "optimization", "endpoints", "symmetry_policy", "ring_policy", "coupled_torsion_trigger", "environment", "strain_reference", "uncertainty_policy", "decision_eligibility", "digest"],
  "properties": {
    "schema_version": {"const": "3.0"}, "protocol_release_id": {"type": "string", "format": "uuid"},
    "geometry_source_ref": {"$ref": "#/$defs/ref"}, "level": {"type": "object"},
    "dihedrals": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}}},
    "increment_degrees": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
    "optimization": {"enum": ["constrained", "rigid"]}, "endpoints": {"enum": ["include_once", "include_both_for_diagnostic"]},
    "symmetry_policy": {"type": "object"}, "ring_policy": {"enum": ["unsupported", "dedicated_ring_scan"]},
    "coupled_torsion_trigger": {"type": "object"}, "environment": {"enum": ["gas_phase", "implicit_solvent", "pose_environment"]},
    "strain_reference": {"enum": ["global_minimum_same_protocol", "unbound_ensemble_same_protocol"]},
    "uncertainty_policy": {"type": "object"}, "decision_eligibility": {"enum": ["descriptive_only", "eligible_if_single_torsion_assumption_passes"]},
    "digest": {"type": "string", "format": "sha256-digest"}
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"type": "string"}, "id": {"type": "string"}}}}
}
