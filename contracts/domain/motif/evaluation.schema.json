{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirac.local/contracts/domain/motif/evaluation.schema.json",
  "title": "Dirac Motif Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "objective_spec_id", "predictions", "conflicts", "warnings", "evaluated_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "proposal_id": {"type": "string", "format": "uuid"},
    "objective_spec_id": {"type": "string", "format": "uuid"},
    "predictions": {"type": "array", "items": {"$ref": "#/$defs/prediction"}, "maxItems": 1000},
    "pose_artifact_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "interaction_artifact_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "field_artifact_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "physics_artifact_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/reason"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/reason"}},
    "evaluated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "prediction": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint_id", "endpoint_version", "model_release_ids", "estimate", "interval", "feasibility_probability", "applicability", "uncertainty", "calibration"],
      "properties": {
        "endpoint_id": {"type": "string", "minLength": 1},
        "endpoint_version": {"type": "string", "minLength": 1},
        "model_release_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
        "estimate": {"type": ["number", "string", "null"]},
        "distribution_artifact_id": {"type": ["string", "null"], "format": "uuid"},
        "interval": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["lower", "upper", "level"],
          "properties": {"lower": {"type": "number"}, "upper": {"type": "number"}, "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}}
        },
        "feasibility_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "applicability": {"enum": ["in_domain", "borderline", "out_of_domain", "unknown"]},
        "uncertainty": {
          "type": "object", "additionalProperties": false,
          "required": ["aleatoric", "epistemic", "structural", "model_disagreement", "decision"],
          "properties": {
            "aleatoric": {"type": ["number", "null"], "minimum": 0},
            "epistemic": {"type": ["number", "null"], "minimum": 0},
            "structural": {"type": ["number", "null"], "minimum": 0},
            "model_disagreement": {"type": ["number", "null"], "minimum": 0},
            "decision": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "calibration": {
          "type": "object", "additionalProperties": false,
          "required": ["release_id", "status"],
          "properties": {
            "release_id": {"type": "string", "format": "uuid"},
            "status": {"enum": ["valid", "stale", "out_of_scope", "missing"]},
            "coverage_target": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          }
        },
        "supporting_artifact_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true}
      }
    },
    "reason": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}, "message": {"type": "string", "minLength": 1}, "details": {"type": "object"}}
    }
  }
}
