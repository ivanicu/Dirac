{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirac.local/contracts/domain/motif/observability-contract.schema.json",
  "title": "Motif Observability Contract",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "metrics", "slos", "high_cardinality_policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "slos": {"type": "array", "items": {"$ref": "#/$defs/slo"}},
    "high_cardinality_policy": {"const": "candidate_job_attempt_and_artifact_ids_in_logs_and_traces_only"}
  },
  "$defs": {
    "metric": {"type": "object", "additionalProperties": false, "required": ["name", "type", "unit", "labels", "aggregation", "retention", "owner", "action"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_:]+$"}, "type": {"enum": ["counter", "gauge", "histogram"]}, "unit": {"type": "string"}, "labels": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "aggregation": {"type": "string"}, "retention": {"type": "string"}, "alert_threshold": {"type": ["number", "null"]}, "owner": {"type": "string"}, "action": {"type": "string"}}},
    "slo": {"type": "object", "additionalProperties": false, "required": ["name", "indicator", "objective", "window", "owner", "breach_action"], "properties": {"name": {"type": "string"}, "indicator": {"type": "string"}, "objective": {"type": "number"}, "window": {"type": "string"}, "owner": {"type": "string"}, "breach_action": {"type": "string"}}}
  }
}
