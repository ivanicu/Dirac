{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirac.local/contracts/domain/motif/routing-action.schema.json",
  "title": "Motif Scientific Routing Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routing_action_id", "evidence_snapshot_ref", "action_kind", "subject_ref", "scientific_question", "required_input_refs", "outcome_model_release_ref", "expected_utility_delta", "resource_estimate", "budget_lease_ref", "reason_codes", "policy_release_ref", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "routing_action_id": {"type": "string", "format": "uuid"},
    "evidence_snapshot_ref": {"$ref": "#/$defs/ref"},
    "action_kind": {"enum": ["compute", "recompute", "extend", "aggregate", "review", "stop", "defer"]},
    "fidelity_label": {"enum": ["F0", "F1", "F2", "F3", "F4", "F5", "not_applicable"]},
    "subject_ref": {"$ref": "#/$defs/ref"},
    "scientific_question": {"type": "string", "minLength": 1, "maxLength": 2048},
    "required_input_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "outcome_model_release_ref": {"$ref": "#/$defs/ref"},
    "expected_utility_delta": {"type": "number"},
    "p_decision_change": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "resource_estimate": {"$ref": "#/$defs/resources"},
    "budget_lease_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,95}$"}},
    "policy_release_ref": {"$ref": "#/$defs/ref"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}},
    "resources": {"type": "object", "additionalProperties": false, "properties": {"walltime_seconds": {"type": "number", "minimum": 0}, "cpu_core_hours": {"type": "number", "minimum": 0}, "gpu_hours": {"type": "number", "minimum": 0}, "gpu_vram_gib_hours": {"type": "number", "minimum": 0}, "scratch_gib_hours": {"type": "number", "minimum": 0}, "persistent_growth_bytes": {"type": "number", "minimum": 0}, "external_cost": {"type": "number", "minimum": 0}}}
  }
}
