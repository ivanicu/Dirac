{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dirac.local/contracts/domain/motif/endpoint-definition.schema.json",
  "title": "Dirac Motif Endpoint Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "endpoint_key", "version", "assay", "protocol",
    "biological_system", "readout", "measurement_type", "direction",
    "canonical_unit", "quantity_dimension", "label_transform",
    "censoring_policy", "replicate_policy", "qc_policy", "intended_domain",
    "created_by", "created_at", "digest"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "endpoint_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "assay": {"$ref": "#/$defs/assay_ref"},
    "protocol": {"$ref": "#/$defs/protocol_ref"},
    "target": {"oneOf": [{"$ref": "#/$defs/target_ref"}, {"type": "null"}]},
    "species": {"type": ["string", "null"], "maxLength": 256},
    "biological_system": {"type": "string", "minLength": 1, "maxLength": 512},
    "readout": {"type": "string", "minLength": 1, "maxLength": 512},
    "measurement_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "direction": {"enum": ["maximize", "minimize", "target_interval", "avoid"]},
    "canonical_unit": {"type": "string", "minLength": 1, "maxLength": 64},
    "quantity_dimension": {"type": "string", "minLength": 1, "maxLength": 128},
    "label_transform": {"type": "object"},
    "censoring_policy": {"type": "object"},
    "replicate_policy": {"type": "object"},
    "qc_policy": {"type": "object"},
    "intended_domain": {"type": "object"},
    "created_by": {"$ref": "#/$defs/actor"},
    "created_at": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "format": "sha256-digest"}
  },
  "$defs": {
    "object_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string"},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "assay_ref": {
      "allOf": [{"$ref": "#/$defs/object_ref"}, {"properties": {"kind": {"const": "assay"}}}]
    },
    "protocol_ref": {
      "allOf": [{"$ref": "#/$defs/object_ref"}, {"properties": {"kind": {"const": "protocol"}}}]
    },
    "target_ref": {
      "allOf": [{"$ref": "#/$defs/object_ref"}, {"properties": {"kind": {"const": "target"}}}]
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "agent", "service"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
