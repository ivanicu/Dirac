{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Program hypothesis atom",
  "type": "object",
  "additionalProperties": true,
  "required": ["key", "title", "statement", "falsification_criterion", "confidence"],
  "properties": {
    "key": {"type": "string"}, "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "falsification_criterion": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
