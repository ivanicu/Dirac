{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Program objective atom",
  "type": "object",
  "additionalProperties": true,
  "required": ["key", "title", "rationale", "category"],
  "properties": {
    "key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"},
    "title": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "category": {"enum": ["efficacy", "selectivity", "developability", "safety", "synthesis", "evidence"]},
    "metric": {"type": ["string", "null"]},
    "direction": {"enum": ["maximize", "minimize", "at_least", "at_most", "within", "qualitative", null]},
    "threshold": {"type": "object"},
    "priority": {"type": "integer", "minimum": 1, "maximum": 5},
    "hardness": {"enum": ["hard", "soft"]}
  }
}
