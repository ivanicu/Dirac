      "input_schema": {
        "type": "object", "required": ["strategy", "generator_release_id", "strategy_release_id", "identity_policy_release_id", "root_seed", "created_at"],
        "properties": {
          "strategy": {"enum": ["local_edit", "reaction"]},
          "parents": {"type": "array", "items": {"type": "object"}},
          "transforms": {"type": "array", "items": {"type": "object"}},
          "reactants": {"type": "array", "items": {"type": "object"}},
          "templates": {"type": "array", "items": {"type": "object"}},
          "generator_release_id": {"type": "string", "format": "uuid"},
          "strategy_release_id": {"type": "string", "format": "uuid"},
          "identity_policy_release_id": {"type": "string", "format": "uuid"},
          "root_seed": {"type": "integer", "minimum": 0},
          "created_at": {"type": "string", "format": "date-time"},
          "constraints": {"type": "object"}, "max_proposals": {"type": "integer", "minimum": 1, "maximum": 50000}
        },
        "allOf": [
          {"if": {"properties": {"strategy": {"const": "local_edit"}}}, "then": {"required": ["parents", "transforms"]}},
          {"if": {"properties": {"strategy": {"const": "reaction"}}}, "then": {"required": ["reactants", "templates"]}}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["job"]}
    },
