    {
      "id": "proposal.generate", "version": 1, "category": "design",
      "mutability": "compute", "execution_class": "long", "executors": ["service"],
      "idempotency_policy": "request-digest", "job_policy": "required", "provenance_policy": "required",
      "input_object_kinds": ["compound", "building_block", "campaign"], "output_object_kinds": ["compound", "synthesis_route", "artifact", "job"],
