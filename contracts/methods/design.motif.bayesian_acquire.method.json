{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "2.0.0", "method_id": "design.motif.bayesian_acquire",
  "summary": "Score candidates with BoTorch qLogEHVI and VOI, then apply exact hard constraints, Pareto ranking and sensitivity analysis.",
  "implementation": {"module": "backend.motif.advanced_acquisition", "functions": ["_digest", "botorch_qehvi", "greedy_diversity", "information_value", "selection_sensitivity"], "constants": ["ACQUISITION_SOURCE_DIGESTS"]},
  "input": {"schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
    "required": ["train_features", "train_objectives", "reference_point", "candidates", "objectives", "capacity"],
    "properties": {
      "train_features": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}},
      "train_objectives": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "items": {"type": "number"}}},
      "reference_point": {"type": "array", "minItems": 2, "items": {"type": "number"}},
      "candidates": {"type": "array", "minItems": 1, "maxItems": 50000, "items": {"type": "object", "required": ["proposal_id", "features", "objectives"]}},
      "objectives": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["key", "direction"]}},
      "hard_constraints": {"type": "array", "items": {"type": "object"}},
      "capacity": {"type": "integer", "minimum": 0},
      "mc_samples": {"type": "integer", "minimum": 16, "maximum": 4096},
      "seed": {"type": "integer", "minimum": 0}
    }
  }},
  "output": {"schema": {"$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object", "additionalProperties": false,
    "required": ["portfolio", "counts", "acquisition_digest", "sensitivity_digest"],
    "properties": {"portfolio": {"type": "object"}, "counts": {"type": "object"},
      "acquisition_digest": {"type": "string", "format": "sha256-digest"},
      "sensitivity_digest": {"type": "string", "format": "sha256-digest"}}}},
  "refusals": [{"code": "INVALID_PARAMETERS", "condition": "inconsistent posterior dimensions, nonpositive costs or invalid objective policy"}],
  "execution": {
    "supported_modes": ["sync", "job"], "default_mode": "job", "resource_class": "cpu",
    "determinism": "numeric_tolerant", "checkpointable": false, "cancellation": "cooperative",
    "artifact_access": ["read:predictions", "write:portfolio"],
    "supported_adapters": ["local_cpu", "slurm", "kubernetes"],
    "scale_profile": {"shardable": true, "distributed": false, "min_gpus": 0, "max_gpus": 0},
    "cacheable": true, "deterministic": true, "side_effects": "immutable_artifacts"
  },
  "exposure": {"sdk": true, "cli": true, "mcp": "curated"},
  "invocation": {"handler": "motif.mesh_methods:acquire_handler", "estimate": "motif.mesh_methods:acquire_estimate",
    "artifacts": [
      {"role": "portfolio.ranking", "media_type": "application/json", "required": true},
      {"role": "portfolio.acquisition_report", "media_type": "application/json", "required": true}
    ]}
}
