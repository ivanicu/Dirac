      "backend.motif.rbfe_chemistry_evidence:mapping_direction_audit",
      "backend.motif.rbfe_chemistry_evidence:pose_geometry_evidence",
      "backend.motif.rbfe_binding:_digest",
      "backend.motif.rbfe_binding:_uuid",
      "backend.motif.rbfe_binding:_sha256",
      "backend.motif.rbfe_binding:validate_campaign_binding",
      "backend.motif.rbfe_binding:build_campaign_binding"
