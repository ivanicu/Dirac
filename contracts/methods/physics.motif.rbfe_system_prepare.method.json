      "backend.motif.rbfe_binding:BINDING_KEYS",
      "backend.motif.rbfe_binding:_SHA256"
    ]
  },
  "input": {"schema": {
    "type": "object", "additionalProperties": false,
    "required": ["campaign_id", "campaign_scientific_generation", "campaign_scientific_digest", "network_ref", "edge_id", "prepared_receptor_state_ref", "parent_pose_ref", "proposal_pose_ref", "protocol_preset"],
    "properties": {
      "campaign_id": {"type": "string", "format": "uuid"},
      "campaign_scientific_generation": {"type": "integer", "minimum": 1},
      "campaign_scientific_digest": {"type": "string", "format": "sha256-digest"},
      "network_ref": {"$ref": "#/$defs/artifact_ref"},
      "edge_id": {"type": "string", "minLength": 1},
      "prepared_receptor_state_ref": {"$ref": "#/$defs/prepared_receptor_ref"},
      "parent_pose_ref": {"$ref": "#/$defs/pose_ref"},
      "proposal_pose_ref": {"$ref": "#/$defs/pose_ref"},
      "protocol_preset": {"const": "openfe-rfe-standard-v1"}
    },
    "$defs": {
      "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256"], "properties": {"kind": {"const": "artifact"}, "id": {"type": "string", "format": "uuid"}, "sha256": {"type": "string", "format": "sha256-digest"}}},
      "prepared_receptor_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256"], "properties": {"kind": {"const": "prepared_receptor_state"}, "id": {"type": "string", "format": "uuid"}, "sha256": {"type": "string", "format": "sha256-digest"}}},
      "pose_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256"], "properties": {"kind": {"const": "pose_hypothesis"}, "id": {"type": "string", "format": "uuid"}, "sha256": {"type": "string", "format": "sha256-digest"}}}
    }
  }},
  "output": {"schema": {
    "type": "object", "additionalProperties": false,
    "required": ["spec_digest", "edge_network_digest", "edge_id", "left_id", "right_id", "complex_transformation_digest", "solvent_transformation_digest", "execution_matrix", "execution_count", "validation_status", "resolved_target", "campaign_binding", "system_build"],
    "properties": {
      "spec_digest": {"type": "string", "format": "sha256-digest"},
      "edge_network_digest": {"type": "string", "format": "sha256-digest"},
      "edge_id": {"type": "string"}, "left_id": {"type": "string"}, "right_id": {"type": "string"},
      "complex_transformation_digest": {"type": "string", "format": "sha256-digest"},
      "solvent_transformation_digest": {"type": "string", "format": "sha256-digest"},
      "execution_matrix": {"type": "array", "minItems": 6, "maxItems": 6},
      "execution_count": {"const": 6}, "validation_status": {"const": "server_preflight_passed"},
      "resolved_target": {"type": "object"}, "campaign_binding": {"type": "object"}, "system_build": {"type": "object"}
    }
  }},
  "refusals": [
    {"code": "INVALID_PARAMETERS", "condition": "Prepared-system resolution, artifact digest, pose/receptor coordinate frame, endpoint charge, LoMap mapping, or generated GUFE validation fails"},
    {"code": "UNSUPPORTED", "condition": "persistent artifact store, target resolver, or pinned OpenFE runtime unavailable"}
  ],
  "execution": {"supported_modes": ["job"], "default_mode": "job", "resource_class": "cpu", "determinism": "bitwise", "checkpointable": false, "cancellation": "cooperative", "artifact_access": ["read:rbfe", "write:rbfe"], "supported_adapters": ["local_cpu", "slurm", "kubernetes"], "cacheable": false, "deterministic": true, "side_effects": "immutable_artifacts"},
  "exposure": {"sdk": true, "cli": true, "mcp": "hidden"},
  "invocation": {"handler": "motif.structure_methods:rbfe_system_prepare_handler", "estimate": "motif.structure_methods:rbfe_estimate", "artifacts": [
    {"role": "rbfe.edge_spec", "media_type": "application/json", "required": true},
    {"role": "rbfe.edge_network", "media_type": "application/json", "required": true},
    {"role": "rbfe.openfe.complex_transformation", "media_type": "application/json", "required": true},
    {"role": "rbfe.openfe.solvent_transformation", "media_type": "application/json", "required": true},
    {"role": "rbfe.system_build_report", "media_type": "application/json", "required": true}
  ]}
}
