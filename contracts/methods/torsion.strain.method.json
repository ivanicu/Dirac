{
  "schema_version": "1.0.0",
  "method_id": "torsion.strain",
  "summary": "Relaxed torsion scan around a rotatable bond: where the given pose sits on the rotor energy curve.",
  "description": "Canonical relaxed torsion-strain method. It runs through the shared invocation kernel, durable JobStore and content-addressed ArtifactStore.",
  "implementation": {
    "module": "backend.physics.torsion",
    "functions": [
      "compute_torsion_strain",
      "_relaxed_scan",
      "_force_field",
      "_relax_hydrogens",
      "_dihedral_atoms",
      "_verdict"
    ],
    "constants": [
      "FORCE_FIELDS",
      "ROTATABLE_SMARTS",
      "TORSION_FORCE_CONSTANT",
      "TORSION_WINDOW_DEG",
      "MINIMIZE_STEPS",
      "VERDICTS"
    ]
  },
  "input": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "molecule"
      ],
      "properties": {
        "molecule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content",
            "dimensionality"
          ],
          "properties": {
            "kind": {
              "const": "molfile"
            },
            "content": {
              "type": "string",
              "minLength": 40
            },
            "format": {
              "enum": [
                "mdl-v2000",
                "mdl-v3000"
              ],
              "default": "mdl-v2000"
            },
            "dimensionality": {
              "const": 3,
              "description": "3 ONLY. A 2D structure must not reach a 3D physics method; molecule.embed is the explicit step that produces 3D, and an implicit SMILES→3D would report one method having run when two did."
            },
            "coordinate_space": {
              "enum": [
                "molecular",
                "scene"
              ],
              "default": "molecular"
            },
            "coordinate_units": {
              "const": "angstrom",
              "default": "angstrom"
            },
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "inchikey": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "compound_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "conformer_hash": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 6,
              "maximum": 360,
              "default": 24
            },
            "relax_hydrogens": {
              "type": "boolean",
              "default": true
            },
            "max_torsions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 12
            },
            "variant": {
              "type": "string",
              "enum": ["MMFF94", "MMFF94s"],
              "default": "MMFF94s"
            }
          }
        }
      }
    }
  },
  "invocation": {
    "handler": "handlers:torsion_handler",
    "estimate": "handlers:torsion_estimate",
    "artifacts": [
      {
        "role": "torsion.profile",
        "media_type": "application/vnd.dirac.torsion-profile+json",
        "required": true,
        "typical_bytes": 400000
      }
    ]
  },
  "output": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "object"
        }
      }
    },
    "artifacts": [
      {
        "role": "torsion.profile",
        "media_type": "application/vnd.dirac.torsion-profile+json",
        "typical_size_bytes": 400000
      }
    ]
  },
  "refusals": [
    {"code": "INVALID_PARAMETERS", "condition": "the molfile is malformed, has no 3D conformer, scan parameters are outside the contract, or the force-field variant is unknown"},
    {"code": "UNSUPPORTED", "condition": "MMFF cannot type the submitted chemistry or construct a force field"},
    {"code": "UNCONVERGED", "condition": "scan minimizations do not converge sufficiently for the quality policy; unconverged points remain visible in the profile"}
  ],
  "warnings": [
    {
      "code": "ONE_DIMENSIONAL_TORSION_NOT_THERMODYNAMIC",
      "meaning": "The gas-phase one-dimensional MMFF profile is descriptive triage; coupled torsions, ring torsions, pose environment and thermodynamic claims are excluded.",
      "scope": [
        "output.summary.total_strain_kcal",
        "artifact.torsion.profile"
      ],
      "measured": "Per-torsion strains are coupled and therefore are never summed; the global same-force-field relaxation is reported separately."
    }
  ],
  "execution": {
    "supported_modes": [
      "sync",
      "job"
    ],
    "default_mode": "job",
    "inline_threshold_seconds": 2.0,
    "resource_class": "cpu",
    "supported_adapters": ["inline", "local_cpu"],
    "concurrency_class": "torsion",
    "scale_profile": {"cpu_cores": 1, "shardable": true, "distributed": false, "min_gpus": 0, "max_gpus": 0},
    "supports_cancellation": false,
    "deterministic": true,
    "cacheable": true,
    "side_effects": "writes_cache"
  },
  "exposure": {
    "sdk": true,
    "cli": true,
    "mcp": "curated"
  }
}
