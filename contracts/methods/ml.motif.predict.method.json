{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "2.0.0", "method_id": "ml.motif.predict",
  "summary": "Predict with a digest-verified Morgan baseline checkpoint and report nearest-neighbor applicability domain.",
  "implementation": {"module": "backend.motif.models", "functions": ["_dense", "_digest", "fingerprint", "predict", "tanimoto"]},
  "input": {"schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object", "additionalProperties": false, "required": ["checkpoint", "smiles"],
    "properties": {
      "checkpoint": {"type": "object", "required": ["schema_version", "algorithm", "digest", "featurizer", "ridge", "nearest_neighbor"]},
      "calibration": {"type": "object", "required": ["digest", "nominal_coverage", "absolute_residual_quantile"]},
      "smiles": {"type": "array", "minItems": 1, "maxItems": 50000, "items": {"type": "string", "minLength": 1}}
    }
  }},
  "output": {"schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object", "additionalProperties": false, "required": ["predictions", "count"],
    "properties": {"predictions": {"type": "array"}, "count": {"type": "integer", "minimum": 0}}
  }},
  "refusals": [{"code": "INVALID_PARAMETERS", "condition": "checkpoint digest mismatch or a molecule cannot be parsed"}],
  "execution": {
    "supported_modes": ["sync", "job"], "default_mode": "job", "resource_class": "cpu",
    "determinism": "numeric_tolerant", "checkpointable": false, "cancellation": "cooperative",
    "artifact_access": ["read:model", "write:predictions"],
    "supported_adapters": ["local_cpu", "local_gpu", "slurm", "kubernetes"],
    "scale_profile": {"shardable": true, "distributed": false, "min_gpus": 0, "max_gpus": 10000},
    "cacheable": true, "deterministic": true, "side_effects": "immutable_artifacts"
  },
  "exposure": {"sdk": true, "cli": true, "mcp": "curated"},
  "invocation": {
    "handler": "motif.methods:predict_handler", "estimate": "motif.methods:predict_estimate",
    "artifacts": [{"role": "model.predictions", "media_type": "application/json", "required": true}]
  }
}
