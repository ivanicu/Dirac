{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "2.0.0",
  "method_id": "physics.motif.rbfe_campaign_prepare",
  "summary": "Durably prepare one saved RBFE campaign into a registered receptor state and same-frame endpoint pose hypotheses without holding an HTTP request open.",
  "implementation": {
    "module": "backend.motif.rbfe_campaign_prepare_method",
    "functions": ["prepare_campaign_handler", "prepare_campaign_estimate"]
  },
  "input": {"schema": {
    "type": "object", "additionalProperties": false,
    "required": ["request_key", "campaign_id", "expected_version", "campaign_name", "target_name", "receptor_pdb", "compounds", "parent_id", "pose_strategy", "reference_ligand", "receptor_policy", "ligand_policy"],
    "properties": {
      "request_key": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": ".*[^\\s\\u00A0\\u2007\\u202F\\uFEFF].*"},
      "campaign_id": {"type": "string", "format": "uuid"},
      "expected_version": {"type": "integer", "minimum": 1},
      "campaign_name": {"type": "string", "minLength": 1, "maxLength": 160},
      "target_name": {"type": "string", "minLength": 1, "maxLength": 160},
      "source_pdb_id": {"type": "string", "maxLength": 16},
      "structure_method": {"enum": ["xray", "cryoem", "nmr", "predicted", "model"]},
      "resolution_angstrom": {"type": ["number", "null"], "exclusiveMinimum": 0},
      "receptor_pdb": {"type": "string", "minLength": 100, "maxLength": 8388608},
      "compounds": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["id", "smiles"], "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "smiles": {"type": "string", "minLength": 1, "maxLength": 4096}
      }}},
      "parent_id": {"type": "string", "minLength": 1, "maxLength": 128},
      "pose_strategy": {"const": "align_to_reference"},
      "reference_ligand": {"type": "object", "additionalProperties": false, "required": ["resname", "chain", "residue_number", "role"], "properties": {
        "resname": {"type": "string", "minLength": 1, "maxLength": 8},
        "chain": {"type": "string", "maxLength": 8},
        "residue_number": {"type": "string", "minLength": 1, "maxLength": 16},
        "role": {"enum": ["experimental_ligand", "cofactor", "buffer", "unknown"]},
        "altloc": {"type": ["string", "null"], "maxLength": 4},
        "occupancy": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }},
      "receptor_policy": {"type": "object", "additionalProperties": false, "required": ["assembly_id", "chain_ids", "missing_atoms", "missing_residues", "altloc", "occupancy", "waters", "water_site_decisions", "cofactors", "metals", "histidines", "termini", "ph", "forcefield_contract"], "properties": {
        "assembly_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "chain_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 16}},
        "missing_atoms": {"enum": ["auto_repair_report", "review_each", "block"]},
        "missing_residues": {"enum": ["auto_repair_report", "review_each", "block"]},
        "altloc": {"enum": ["review_each", "highest_occupancy", "block_ambiguous"]},
        "occupancy": {"enum": ["review_zero", "reject_zero", "keep_reported"]},
        "waters": {"enum": ["review_pocket", "remove_all", "keep_all"]},
        "water_site_decisions": {"type": "array", "items": {"type": "object"}},
        "cofactors": {"enum": ["keep_parameter_gate", "remove", "review_each"]},
        "metals": {"enum": ["keep_parameter_gate", "remove", "review_each"]},
        "histidines": {"enum": ["server_assign_review", "manual"]},
        "termini": {"enum": ["server_assign_review", "manual"]},
        "ph": {"type": "number", "minimum": 0, "maximum": 14},
        "forcefield_contract": {"type": "object", "minProperties": 1}
      }},
      "ligand_policy": {"type": "object", "additionalProperties": false, "required": ["formal_charge", "tautomer", "protonation", "stereochemistry", "state_population_cutoff"], "properties": {
        "formal_charge": {"enum": ["block_changes", "allow_governed"]},
        "tautomer": {"enum": ["strict", "dominant_only", "enumerate"]},
        "protonation": {"enum": ["specified_only", "enumerate_at_ph"]},
        "stereochemistry": {"enum": ["preserve_block_unknown", "enumerate_unknown"]},
        "state_population_cutoff": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }},
      "minimum_core_coverage": {"type": "number", "minimum": 0.3, "maximum": 1},
      "seed": {"type": "integer", "minimum": 1, "maximum": 4294967295}
    }
  }},
  "output": {"schema": {
    "type": "object", "additionalProperties": true,
    "required": ["campaign_ref", "campaign_version", "campaign_state_digest", "campaign_scientific_ref", "campaign_scientific_generation", "campaign_scientific_digest", "prepared_receptor_state_ref", "target_ref", "protein_structure_ref", "preparation_state", "poses", "claim_boundary"],
    "properties": {
      "campaign_ref": {"type": "object"},
      "campaign_version": {"type": "integer", "minimum": 1},
      "campaign_state_digest": {"type": "string", "format": "sha256-digest"},
      "campaign_scientific_ref": {"type": "object"},
      "campaign_scientific_generation": {"type": "integer", "minimum": 1},
      "campaign_scientific_digest": {"type": "string", "format": "sha256-digest"},
      "prepared_receptor_state_ref": {"type": "object"},
      "target_ref": {"type": "object"},
      "protein_structure_ref": {"type": "object"},
      "preparation_state": {"type": "string"},
      "poses": {"type": "array"},
      "claim_boundary": {"type": "string"}
    }
  }},
  "refusals": [
    {"code": "INVALID_PARAMETERS", "condition": "campaign generation, receptor policy, ligand identity, stereochemistry, or shared-frame pose construction is not admissible"},
    {"code": "DB_UNAVAILABLE", "condition": "durable campaign, reference resolver, or PostgreSQL artifact writer is unavailable"},
    {"code": "UNSUPPORTED", "condition": "required pinned native preparation tools are unavailable"}
  ],
  "execution": {
    "supported_modes": ["job"], "default_mode": "job",
    "resource_class": "cpu", "determinism": "numeric_tolerant",
    "checkpointable": false,
    "cancellation": "queued_only",
    "artifact_access": ["write:rbfe"],
    "supported_adapters": ["local_cpu"],
    "scale_profile": {"shardable": false, "distributed": false, "min_gpus": 0, "max_gpus": 0, "cpu_cores": 2},
    "cacheable": false, "deterministic": false,
    "side_effects": "immutable_artifacts"
  },
  "exposure": {"sdk": true, "cli": true, "mcp": "hidden"},
  "invocation": {
    "handler": "motif.rbfe_campaign_prepare_method:prepare_campaign_handler",
    "estimate": "motif.rbfe_campaign_prepare_method:prepare_campaign_estimate",
    "artifacts": []
  }
}
