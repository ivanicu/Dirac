  "invocation": {"handler": "motif.structure_methods:rbfe_plan_handler", "estimate": "motif.structure_methods:rbfe_estimate",
    "admission": {"handler": "motif.structure_methods:attest_rbfe_network_admission", "attestation_key": "rbfe_network_campaign"},
    "artifacts": [{"role": "rbfe.network", "media_type": "application/json", "required": true}]}
