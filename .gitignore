build/
# deploy/ was ignored as a BUILD OUTPUT dir; deploy/systemd holds hand-written
# unit files that must ship (a supervision story nobody can read is no story).
deploy/*
!deploy/systemd/
!deploy/kubernetes/
!deploy/ai/
deploy/ai/*
!deploy/ai/providers.example.json
!deploy/README.md
!deploy/Caddyfile.remote.example
!deploy/dirac-tokens.example.json
# ANCHORED to the repo root, and the missing slash was not cosmetic: `lib/`
# matches at ANY depth, so it silently swallowed scripts/lib/ — a load-bearing
# module a gate imports. The commit succeeded, the local tree looked complete,
# and CI would have failed on a file that was never shippable. Second instance
# of this exact class in this file (see deploy/ above), so: an unanchored
# gitignore pattern is a wildcard over DEPTH, not a directory name.
/lib/
docs/site/

node_modules/
debug.log
npm-debug.log
tsconfig.tsbuildinfo
tsconfig.commonjs.tsbuildinfo

*.sublime-workspace
.idea

.DS_Store
tmp/

dev.pem
dev-key.pem

data/sym/syminfo.lib
backend/env/
/.runtime/
/openfe-runtime-v2
/backups/

# a tracked .pyc dirties the worktree on every import (it happened)
__pycache__/
*.pyc
