#!/usr/bin/env bash
# Safe local operator wrapper for the one supervised Dirac topology.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

UNITS=(dirac-web dirac-fields dirac-ops dirac-digital-twin)

build() {
    npm run build:dirac
}

probe() {
    local name="$1" url="$2" code
    code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 4 "$url" 2>/dev/null || true)"
    if [[ "$code" =~ ^2 ]]; then
        printf '%-24s %-8s %s\n' "$name" "HTTP $code" "$url"
    else
        printf '%-24s %-8s %s\n' "$name" "${code:-down}" "$url"
    fi
}

status() {
    systemctl --user --no-pager status "${UNITS[@]}" || true
    printf '\n%-24s %-8s %s\n' ENDPOINT STATUS URL
    probe dirac-web http://127.0.0.1:1360/
    probe dirac-fields http://127.0.0.1:8901/health
    probe dirac-ops http://127.0.0.1:1355/
}

up() {
    systemctl --user start "${UNITS[@]}"
    status
}

restart() {
    build
    systemctl --user restart dirac-fields dirac-web dirac-ops dirac-digital-twin
    status
}

logs() {
    journalctl --user -u dirac-web -u dirac-fields -u dirac-ops \
        -u dirac-digital-twin -n 150 --no-pager
}

case "${1:-status}" in
    build) build ;;
    status) status ;;
    up) up ;;
    restart) restart ;;
    logs) logs ;;
    down)
        printf '%s\n' \
            'bin/dev does not stop shared supervised services.' \
            'If shutdown is intentional, name the exact units with systemctl --user stop.' >&2
        exit 2
        ;;
    *)
        echo 'usage: bin/dev {build|status|up|restart|logs}' >&2
        exit 2
        ;;
esac
