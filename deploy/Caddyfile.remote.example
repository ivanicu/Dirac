# Replace the hostname, then point DNS at this host. Caddy obtains and renews TLS.
api.dirac.example.com {
    request_body {
        max_size 8MB
    }
    reverse_proxy 127.0.0.1:8901 {
        # Caddy sets this itself; spelling it out makes Dirac's fail-closed
        # X-Forwarded-Proto requirement visible in the deploy source of truth.
        header_up X-Forwarded-Proto https
    }
}
